+	if (DECL_PACKED(t)
+	    || TYPE_PACKED(TREE_TYPE(t))
+	    || DECL_BIT_FIELD_TYPE(t)
+	    || !DECL_SIZE_UNIT (t))
+	  return MOVE_RATIO + 2;
+	if (TREE_CODE (TREE_TYPE (t)) == RECORD_TYPE)
+	  count += move_by_fields_ninsns (TREE_TYPE (t));
+	else if (TYPE_MODE (TREE_TYPE (t)) != BLKmode)
+	  ++count;
+	else
