+	    enum machine_mode mode = TYPE_MODE (TREE_TYPE (t));
+	    rtx to1 = adjust_address (to, mode, offset + fld_offset);
+	    rtx from1 = adjust_address (from, mode, offset + fld_offset);
+	    if (mode == BLKmode)
