+  snprintf (response_filename,
+	    BUFSIZ,
+	    "@%s/%s_%d_%d.rsp",
+	    tmpdir,
+	    basename,
+	    myself,
+	    response_file_sequence);
+
+  ++ response_file_sequence;
+
+  rsp_fp = fopen (response_filename + 1, "w");
+
+  if (rsp_fp == NULL)
+    return NULL;
+
+  /* dont emit commnad name into the response file */
+  while (*argv != NULL)
+    {
+      if (**argv == NULL)
+	continue;
+
+      /* check if the argv requres quoted. */
+      if (index (*argv, ' ') != NULL || index (*argv, '\t') != NULL)
+	fprintf (rsp_fp, "\"%s\"\n", *argv);
+      else
+	fprintf (rsp_fp, "%s\n", *argv);
+
+      ++argv;
+    }
+
+  fclose (rsp_fp);
+
+  return response_filename;
