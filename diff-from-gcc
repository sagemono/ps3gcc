+/*
+  Propagate partial dirty register information in basic-block BB
+  and record the information at each instruction in PDINSNS 
+*/
+
+static void
+pd_bb_propagate (basic_block bb, pd_insn_info *pdinsns, struct df *df)
+{
+  rtx insn, bound;
+  bool dst_dirty;
+  bitmap wset = BITMAP_ALLOC (NULL);
+
+  if (PD_BB_INFO (bb)->visited)
+    return;
+
+  PD_BB_INFO (bb)->visited = true;
+  bitmap_copy (wset, PD_BB_INFO (bb)->live_pdin);
+
+  bound = NEXT_INSN (BB_END (bb));
+  for (insn = BB_HEAD (bb); insn != bound; insn = NEXT_INSN (insn))
+    if (INSN_P (insn))
+      {
+	bitmap_ior_into (pdinsns[INSN_UID(insn)].live_pd, wset);
+		
+	dst_dirty = true;
+	if (ZERO_EXTENSION_INSN_P (insn))
+	  dst_dirty = false;
+	else 
+	  dst_dirty = pd_is_any_src_dirty (insn, wset, df) ? true : false;
+		
+	/* set each destination register partially dirty */
+	pd_mark_dest_dirty (insn, wset, dst_dirty, df);
+      }
+    
+  bitmap_ior_into (PD_BB_INFO (bb)->live_pdout, wset);
+
+  BITMAP_FREE (wset);
+}
