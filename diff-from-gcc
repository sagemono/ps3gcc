+  if (TYPE_P (*node))
+    {
+      if (!(flags & (int) ATTR_FLAG_TYPE_IN_PLACE))
+	*node = build_variant_type_copy (*node);
+
+      TYPE_ATTRIBUTES (*node) = tree_cons (get_identifier ("d64_abi"),
