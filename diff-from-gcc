+/* The function frees the allocated info of all instructions .  */
+
+static void 
+pd_free_insn_table (pd_insn_info *pdinsns)
+{
+  if (pdinsns) 
+    {
+      int i;
+      int n_insns = get_max_uid () + 1;
+
+      for (i = 0; i < n_insns; i++)
+	BITMAP_FREE (pdinsns[i].live_pd);
+
+      free (pdinsns);
+    }
