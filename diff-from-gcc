+    code = GET_CODE(cond);
+    a = emit_store_flag(a, code, XEXP (cond, 0), XEXP (cond, 1), VOIDmode,
+	(code == LTU || code == LEU || code == GEU || code == GTU), 0);
+    seq_a = get_insns();
+    end_sequence();
+
+    if (!a)
+      return FALSE;
+
+    start_sequence ();
+    b = gen_reg_rtx(mode);
+    code = GET_CODE(then_cond);
+    b = emit_store_flag(b, code, XEXP (then_cond, 0), XEXP (then_cond, 1), VOIDmode,
+	(code == LTU || code == LEU || code == GEU || code == GTU), 0);
+    seq_b = get_insns();
+    end_sequence();
+
+    if (!b)
+      return FALSE;
+
+    emit_insn_before(seq_a, test_earliest);
+    emit_insn_before(seq_b, then_earliest);
+
+    start_sequence ();
+    t = gen_reg_rtx(mode);
+    if (andif)
+      emit_insn(gen_rtx_SET(VOIDmode, t, gen_rtx_IOR(mode, a, b)));
