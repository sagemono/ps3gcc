+	    tree ss_index)
+{
+  tree tmp_var, type, lhs;
+  tree ss_stmts[SS_PREDS_MAX];
+  tree new_sink_stmt, new_lhs;
+  block_stmt_iterator sink_bsi;
+  unsigned int i;
