+/* helper for rs6000_use_address_p below. Find the address of a store
+   RTL or return NULL if it cannot be found. */
+static rtx
+rs6000_find_store_address (rtx x)
+{
+  int i;
+  rtx tmp;
+
+  switch (GET_CODE (x))
+    {
+    case MEM:
+    return x;
+    case SET:
+      return rs6000_find_store_address (XEXP (x, 0));
+    case PARALLEL:
+      for (i = 0; i < XVECLEN (x, 0); i++)
+	{
+	  tmp = rs6000_find_store_address (XVECEXP (x, 0, i));
+	  if (tmp != NULL_RTX)
+	    return tmp;
+	}
+      return NULL_RTX;
+    default:
+      return NULL_RTX;
+    }
+}
+
+/* helper for rs6000_use_address_p below. Find the address of a store
+   RTL or return NULL if it cannot be found. */
+static rtx
+rs6000_find_set_target_reg (rtx x)
+{
+  int i;
+  rtx tmp;
+
+  switch (GET_CODE (x))
+    {
+    case REG:
+      return x;
+    case SET:
+    case SUBREG:
+    case ZERO_EXTRACT:
+      return rs6000_find_set_target_reg (XEXP (x, 0));
+    case PARALLEL:
+      for (i = 0; i < XVECLEN (x, 0); i++)
+	{
+	  tmp = rs6000_find_set_target_reg (XVECEXP (x, 0, i));
+	  if (tmp != NULL_RTX)
+	    return tmp;
+	}
+      return NULL_RTX;
+    default:
+      return NULL_RTX;
+    }
+}
