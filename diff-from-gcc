+/* The function allocates the info structures for each basic block.  It
+   also initialized LIVE_PDIN and LIVE_PDOUT as if all hard
+   registers were not partially dirty.  */
+
+static void
+pd_allocate_bb_info (void)
+{
+  basic_block bb;
+  pd_bb_info *bb_info;
+
+  alloc_aux_for_blocks (sizeof (pd_bb_info));
+
+  FOR_EACH_BB (bb)
+    {
+      bb_info = PD_BB_INFO (bb);
+      bb_info->live_pdin  = BITMAP_ALLOC (NULL);
+      bb_info->live_pdout = BITMAP_ALLOC (NULL);
+      bb_info->visited = false;
+    }
+}
+
+/* The function frees the allocated info of all basic blocks. */
+
+static void
+pd_free_bb_info (void)
+{
+  basic_block bb;
+  pd_bb_info *bb_info;
+
+  FOR_EACH_BB (bb)
+    {
+      bb_info = PD_BB_INFO (bb);
+      BITMAP_FREE (bb_info->live_pdout);
+      BITMAP_FREE (bb_info->live_pdin);
+    }
+  free_aux_for_blocks ();
+}
