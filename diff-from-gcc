+
+	     struct _Foo_ {
+	       ...
+	     } __ attribute__((__d64_abi__)); 
+	  */
+	  tree probe;
+
+	  for (probe = *node; probe; probe = TYPE_NEXT_VARIANT (probe))
+	      TYPE_ATTRIBUTES (probe) = tree_cons (get_identifier ("d64_abi"),
+						   NULL_TREE,
+						   TYPE_ATTRIBUTES (probe));  
+	}
+    }
+  else
+    {
+      warning (OPT_Wattributes, "%qE attribute ignored", name);
+      *no_add_attrs = true;
+    }
+
+  return NULL_TREE;
