+static void
+dump_got_section (bfd *abfd, asection *section, void *disasm_info)
+{
+  bfd_byte *data = 0;
+  bfd_size_type gotoff;
+  bfd_size_type datasize;
+  /* Bytes per line.  */
+  bfd_vma  got_entry;
+  size_t entsz = (elf_elfheader(abfd)->e_ident[EI_OSABI] == ELFOSABI_CELLOSLV2)
+    ? 4: 8;
+  asymbol *sym;
+
+  if ((section->flags & SEC_HAS_CONTENTS) == 0)
+    return;
+
+  if (! process_section_p (section))
+    return;
+
+  if (strcmp (section->name, ".got") != 0)
+    return;
+
+  if ((datasize = bfd_section_size (abfd, section)) == 0)
+    return;
+
+  printf (_("Contents of section %s:\n"), section->name);
+
+  data = xmalloc (datasize);
+
+  bfd_get_section_contents (abfd, section, data, 0, datasize);
+
+  /* Compute the address range to display.  */
+  start_address = section->vma;
+
+  if (start_address % entsz != 0)
+    abort();
+  if (datasize % entsz != 0)
+    abort();
+  
+  for (gotoff = 0; gotoff < datasize; gotoff += entsz)
+    {
+      bfd_printf_vma (abfd, gotoff + section->vma);
+      printf ("\t");
+      if (entsz == 8)
+	{
+	got_entry = bfd_get_64 (abfd, &data[gotoff]);
+	objdump_print_addr (got_entry, disasm_info, FALSE);
+	}
+      else
+      {
+	got_entry = bfd_get_32 (abfd, &data[gotoff]);
+	printf ("%08x\t", (unsigned int)got_entry);
+	sym = find_symbol_for_address (got_entry, disasm_info, NULL);
+	if (sym != NULL)
+	  objdump_print_symname (abfd, disasm_info, sym);
+	else
+	  printf ("<unknown>");
+      }
+      printf ("\n");
+    }
+  free (data);
+}
