+
+DEF_VEC_P(basic_block);
+DEF_VEC_ALLOC_P(basic_block,heap);
+
+/*  Data flow analysis for partial dirty registers. */
+
+static void
+pd_dataflow_analysis (pd_insn_info *pdinsns, struct df *df)
+{
+  basic_block bb;
+  edge e;
+  edge_iterator ei;
+  bitmap wset;
+  sbitmap pending;
+  VEC(basic_block,heap) *bbs;
+   
+  /* Initialization of basic block info and DFS traversing stack */ 
+  pd_allocate_bb_info ();
+  wset = BITMAP_ALLOC (NULL);
+  bbs = VEC_alloc (basic_block, heap, n_basic_blocks);
+  pending = sbitmap_alloc (last_basic_block);
+  sbitmap_zero (pending);
+
+  /* DFS traverse from entry until the flow is stable */
+  FOR_EACH_EDGE (e, ei, ENTRY_BLOCK_PTR->succs)
+    {
+      VEC_quick_push (basic_block, bbs, e->dest);
+      SET_BIT (pending, e->dest->index);
+    }
+
+  while (VEC_length (basic_block, bbs))
+    {
+      bb = VEC_pop (basic_block, bbs);
+      RESET_BIT (pending, bb->index);
+
+      pd_bb_propagate (bb, pdinsns, df);
+      
+      bitmap_copy (wset, PD_BB_INFO (bb)->live_pdout);
+
+      FOR_EACH_EDGE (e, ei, bb->succs)
+	{
+	  basic_block succ = e->dest;
+	  if (succ->index != EXIT_BLOCK) 
+	    {
+	      bitmap_ior_into (wset, PD_BB_INFO (succ)->live_pdin);
+
+	      if (!PD_BB_INFO (succ)->visited || 
+		  !bitmap_equal_p (wset, PD_BB_INFO (succ)->live_pdin))
+		{
+		  bitmap_copy (PD_BB_INFO (succ)->live_pdin, wset);
+		  if (!TEST_BIT (pending, succ->index))
+		    {
+		      VEC_quick_push (basic_block, bbs, succ);
+		      SET_BIT (pending, succ->index);
+		    }
+		}
+	    }
+	}
+    }
+  
+  /* Free allocated space */
+  sbitmap_free (pending);
+  BITMAP_FREE (wset);
+  VEC_free (basic_block, heap, bbs);
+  pd_free_bb_info ();
+}
