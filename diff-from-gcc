+   without another pass on the IR, CSE should have detected that
+   (zero_extend:DI (subreg:SI/u (reg:DI N)) is the same as (reg:DI N)
+   but time is running out and this is the quickest way I could modify
+   the code that transmeta added which was not wrong, just not conserative
+   enough.  This additional check is conserative and fixes the regression.  */
+
+static bool
+pd_def_ok (rtx reg, bool top_one, struct df *df)
+{
+  int a;
+  struct df_link *defs_link;
+
+  /* If aggresive is requested, trust the user.  */
+  if (flag_ptr_extension_reduction_really_agg)
+    return true;
+
+  if (GET_CODE (reg) != REG)
+    return true;
+
+  a = REGNO (reg);
+
+  if (a < FIRST_PSEUDO_REGISTER)
+    return false;
+
+  if (df->regs[a].n_defs == 0)
+    return true;
+
+  for (defs_link = df->regs[a].defs; defs_link; defs_link = defs_link->next)
+    {
+      rtx insn = defs_link->ref->insn;
+      rtx r;
+      r = single_set (insn);
+      if (!r)
+	return false;
+      r = SET_SRC (r);
+
+      if (r == reg)
+	continue;
+
+      /* For REGs, just look at its def only if we are the top level check,
+         to make sure we don't go into an infinite loop. */
+      if (top_one
+	  && GET_CODE (r) == REG
+	  && pd_def_ok (r, false, df))
+	continue;
+
+      /* For Subregs, check if they are promoted unsigned.  */
+      if (GET_CODE (r) == SUBREG
+	  && SUBREG_PROMOTED_VAR_P (r)
+	  && SUBREG_PROMOTED_UNSIGNED_P (r))
