+/* Similar to move_by_pieces.  This is only for simple RECORD_TYPES
+   which don't contain bitfields, unions or arrays.  Instead of copying
+   memory a block at a time, we copy it one field at a time, using the
+   corresponding mode.  This allows later optimizations to potentially
+   eliminate these copies, e.g., during CSE or the loop optimizer.
+
+   TODO:  Currently this is called whenever it takes less insns then
+   MOVE_RATIO, but move_by_pieces might take even fewer insns.  In that
+   case, move_by_pieces would be better only if the insns generated by
+   move_by_fields are not optimized away.  Perhaps we should only call
+   this if move_by_fields generates no more insns than move_by_pieces.
+   TODO:  move_by_fields does not take advantage of any pre/post
+   increment/decrement insns.
+   */
+
+static void
+move_by_fields (rtx to, rtx from, unsigned HOST_WIDE_INT offset,
+		unsigned HOST_WIDE_INT len, unsigned int align, tree type)
+{
+  tree t;
+
+  if (to == NULL_RTX)
+    {
+      move_by_pieces (to, from, len, align, 0);
+      return;
+    }
+  for (t = TYPE_FIELDS (type); t; t = TREE_CHAIN (t))
+    if (TREE_CODE (t) == FIELD_DECL)
+      {
+	HOST_WIDE_INT fld_offset = TREE_INT_CST_LOW (DECL_FIELD_OFFSET (t))
+			+ TREE_INT_CST_LOW (DECL_FIELD_BIT_OFFSET (t)) / BITS_PER_UNIT;
+	if (TREE_CODE (TREE_TYPE (t)) == RECORD_TYPE)
+	  move_by_fields (to, from,
+			  offset + fld_offset,
+			  TREE_INT_CST_LOW (DECL_SIZE_UNIT (t)), align, TREE_TYPE (t));
+	else
+	  {
+	    enum machine_mode mode = TYPE_MODE (TREE_TYPE (t));
+	    rtx to1 = adjust_address (to, mode, offset + fld_offset);
+	    rtx from1 = adjust_address (from, mode, offset + fld_offset);
+	    if (mode == BLKmode)
+	      {
+		/* fprintf(stderr, "move_by_pieces in move_by_fields.\n"); */
+		move_by_pieces (to1, from1,
+				TREE_INT_CST_LOW (DECL_SIZE_UNIT (t)),
+				DECL_ALIGN (t), 0);
+	      }
+	    else
+	      emit_move_insn(to1, from1);
+	  }
+      }
+}
