+      /* Build up fake argv & argv for option parser. */
+      second_str = TREE_STRING_POINTER (second_arg);
+      sl = strlen (second_str) + 1;
+      option_list = (char *)alloca (sl);
+      strncpy (option_list, second_str, sl);
+
+      /* number of elements in argv is always less then length of option_list */
+      targv = (char **)alloca (sl);
+      targv[0] = progname;
