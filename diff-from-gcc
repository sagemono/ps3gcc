+      else if (strcmp (op, "nopeel") == 0)
+	pli->peel_times = -1;
+      else if (strcmp (op, "peel") == 0)
+	{
+	  pragma_loop_seen |= PRAGMA_LOOP_PEEL;
+	  pli->peel_times = 0;
+	  pi = &pli->peel_times;
+	}
+      else if (strcmp (op, "nosms") == 0)
+	pli->sms_minii = -1;
+      else if (strcmp (op, "sms") == 0)
+	{
+	  pragma_loop_seen |= PRAGMA_LOOP_SMS;
+	  if (pli->sms_minii < 0)
+	    pli->sms_minii = 0;
+	}
+      else if (strcmp (op, "minii") == 0)
+	{
+	  pli->sms_minii = 0;
+	  pi = &pli->sms_minii;
+	  req = 1;
+	}
+      else if (strcmp (op, "maxsc") == 0)
+	{
+	  pli->sms_maxsc = 0;
+	  pi = &pli->sms_maxsc;
+	  req = 1;
+	}
+      else if (strcmp (op, "mult") == 0)
+	{
+	  pli->multiple = 0;
+	  pi = &pli->multiple;
+	  req = 1;
+	}
+      else if (strcmp (op, "noalias") == 0)
+	pli->noalias = 1;
+      else if (strcmp (op, "min") == 0)
