+	  || GET_CODE (XVECEXP (PATTERN (prev_insn), 0, 0)) == PGO_INFO_VALUE))
+    nop = "#nop";
+
+  switch (kind)
+    {
+    case GCOV_COUNTER_ARCS:
+      fprintf (asm_out_file, "\t\t.popsection\n");
+      return nop;
+
+    case GCOV_COUNTER_V_INTERVAL:
