+/* helper for rs6000_use_address_p below. Find the address of a store
+   RTL or return NULL if it cannot be found. */
+static rtx
+rs6000_find_store_address (rtx x)
+{
+  int i;
+  rtx tmp;
+
+  switch (GET_CODE (x))
+    {
+    case MEM:
+    return x;
+    case SET:
+      return rs6000_find_store_address (XEXP (x, 0));
+    case PARALLEL:
+      for (i = 0; i < XVECLEN (x, 0); i++)
+	{
+	  tmp = rs6000_find_store_address (XVECEXP (x, 0, i));
+	  if (tmp != NULL_RTX)
+	    return tmp;
+	}
+      return NULL_RTX;
+    default:
+      return NULL_RTX;
+    }
+}
+
+/* helper for rs6000_use_address_p below. Find the address of a store
+   RTL or return NULL if it cannot be found. */
+static rtx
+rs6000_find_set_target_reg (rtx x)
+{
+  int i;
+  rtx tmp;
+
+  switch (GET_CODE (x))
+    {
+    case REG:
+      return x;
+    case SET:
+    case SUBREG:
+    case ZERO_EXTRACT:
+      return rs6000_find_set_target_reg (XEXP (x, 0));
+    case PARALLEL:
+      for (i = 0; i < XVECLEN (x, 0); i++)
+	{
+	  tmp = rs6000_find_set_target_reg (XVECEXP (x, 0, i));
+	  if (tmp != NULL_RTX)
+	    return tmp;
+	}
+      return NULL_RTX;
+    default:
+      return NULL_RTX;
+    }
+}
+
+/*
+ * This returns non-zero if the instruction insn1 writes
+ * to a register that is used in the address part of
+ * instruction insn2.
+ */
+int
+rs6000_use_address_p (rtx insn1, rtx insn2)
+{
+  rtx target, addr = NULL_RTX;
+
+  target = rs6000_find_set_target_reg (PATTERN (insn1));
+  if (target == NULL_RTX) 
+    return 0;
+  gcc_assert (GET_CODE (target) == REG);
+
+  switch (get_attr_type (insn2))
+    {
+    case TYPE_STORE:
+    case TYPE_FPSTORE:
+    case TYPE_VECSTORE:
+    case TYPE_STORE_UX:
+    case TYPE_STORE_U:
+    case TYPE_FPSTORE_U:
+    case TYPE_FPSTORE_UX:
+      addr = rs6000_find_store_address (PATTERN (insn2));
+      break;
+
+    default:	/* not a store instruction */
+      return 0;
+    }
+
+    gcc_assert (GET_CODE (addr) == MEM);
+    /* since we know this is MEM, just check the inner part */
+    return (reg_mentioned_p (target, XEXP (addr, 0)));
+}
