+static int
+noce_try_cmove_aggressive (ce_if_block_t * ce_info)
+{
+#if HAVE_conditional_move
+  basic_block hdr = ce_info->test_bb;
+  basic_block fallthru = ce_info->then_bb;
+  basic_block taken = ce_info->else_bb;
+
