+/* Used to emit data to the .pgo_info section.
+   This section is used by external programs (e.g. simulators) to collect
+   profiling data instead of instrumenting the program itself.
+   ??? Evidently the rtx vector operand has to appear first in the pattern.
+
+   The patterns are:
+
+   (pgo_info_arc [(match_operand 1 "const_int_operand" "")
+		  (match_operand 2 "const_int_operand" "")]
+		 (match_operand 0 "const_int_operand" ""))
+
+   (pgo_info_value [(match_operand 1 "const_int_operand" "")
+		    (match_operand 2 "register_operand" "")
+		    (match_operand 3 "const_int_operand" "")
+		    (match_operand 4 "const_int_operand" "")
+		    (match_operand 5 "const_int_operand" "")]
+		   (match_operand 0 "const_int_operand" ""))
+
+   There are no constraints because we don't care what kind of register
+   the value is in (and in fact we'd rather support all the various kinds
+   of values without having to deal with register classes).
+
+   pgo_info_arc:
+   Operand 0 is a CONST_INT specifying the kind of profiling data to be
+     collected.
+   Operand 1 is a CONST_INT specifying the counter number.
+   Operand 2 is a CONST_INT specifying additional arguments.
+	This is for future concerns.
+
+   pgo_info_value:
+   Operand 0 is a CONST_INT specifying the kind of profiling data to be
+     collected.
+   Operand 1 is a CONST_INT specifying the counter number.
+   Operand 2 is an rtx of the register containing the value being profiled.
+   Operand 3 is a CONST_INT specifying additional arguments.
+	This is used by interval and pow2 counters.
+   Operand 4 is a CONST_INT specifying additional arguments.
+	This is used by interval counters.
+   Operand 5 is a CONST_INT specifying additional arguments.
+	This is for future concerns.
+
+   Currently supported profiling kinds are:
+     GCOV_COUNTER_ARCS
+     GCOV_COUNTER_V_INTERVAL
+     GCOV_COUNTER_V_POW2
+     GCOV_COUNTER_V_SINGLE
+     GCOV_COUNTER_V_DELTA
+
+   ??? The use of a vector to contain operands 1,2,... was done early to
+   allow more flexibility during design/development.  As things solidify one
+   may of course wish to revisit this (and other choices).
+*/
+DEF_RTL_EXPR(PGO_INFO_ARC, "pgo_info_arc", "Ee", RTX_EXTRA)
