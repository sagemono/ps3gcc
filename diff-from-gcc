+  int is_type = 0;
+
+  if (DECL_P (*node))
+    {
+      decl = *node;
+      type = &TREE_TYPE (decl);
+      is_type = TREE_CODE (*node) == TYPE_DECL;
+    }
+  else if (TYPE_P (*node))
+    type = node, is_type = 1;
+
+  if (is_type
+      && TREE_CODE (*type) == RECORD_TYPE
+      && decl == 0)
+    {
+      if (!(flags & (int) ATTR_FLAG_TYPE_IN_PLACE))
+	*type = build_variant_type_copy (*type);
+    }
+  else
+    {
+      if (TYPE_P (*node))
+	warning (OPT_Wattributes,
+		 "%qT not valid for %qs attribute, not a record type",
+		 *node,
+		 IDENTIFIER_POINTER (name));
+      else if (DECL_P (*node))
+	warning (OPT_Wattributes,
+		 "%qD not valid for %qs attribute, not a record type",
