+/* The following structs contain basic block instruction data flow 
+   information used to propagate partial dirty (uninitialized) registers
+ */
+
+typedef struct
+{
+  bitmap live_pdin;
+  bitmap live_pdout;
+  bool   visited;
+} pd_bb_info;
+
+typedef struct
+{
+  bitmap live_pd;
+} pd_insn_info;
+
+#define PD_BB_INFO(BB) ((pd_bb_info *) (BB)->aux)
+
+/* Return true if the instruction is a zero-extension instruction
+   and the source operand is a register operand */
+
+#define REG_ZERO_EXTENSION_INSN_P(INSN)			      \
+  (NONJUMP_INSN_P (insn) &&                                   \
+   GET_CODE (PATTERN (insn)) == SET &&			      \
+   REG_P (SET_DEST (PATTERN (insn))) &&			      \
+   GET_MODE (SET_DEST (PATTERN (insn))) == Pmode &&	      \
+   GET_CODE (SET_SRC (PATTERN (insn))) == ZERO_EXTEND &&      \
+   GET_MODE (SET_SRC (PATTERN (insn))) == Pmode &&	      \
+   REG_P (XEXP (SET_SRC (PATTERN (insn)), 0)) &&	      \
+   GET_MODE (XEXP (SET_SRC (PATTERN (insn)), 0)) == ptr_mode) ? true : false 
+
+/* Return true if the instruction is a zero-extension instruction
+   and the source operand is a memory operand */
+
+#define MEM_ZERO_EXTENSION_INSN_P(INSN)			      \
+  (NONJUMP_INSN_P (insn) &&                                   \
+   GET_CODE (PATTERN (insn)) == SET &&			      \
+   REG_P (SET_DEST (PATTERN (insn))) &&			      \
+   GET_MODE (SET_DEST (PATTERN (insn))) == Pmode &&	      \
+   GET_CODE (SET_SRC (PATTERN (insn))) == ZERO_EXTEND &&      \
+   GET_MODE (SET_SRC (PATTERN (insn))) == Pmode &&	      \
+   MEM_P (XEXP (SET_SRC (PATTERN (insn)), 0)) &&	      \
+   GET_MODE (XEXP (SET_SRC (PATTERN (insn)), 0)) == ptr_mode) ? true : false 
+
+#define ZERO_EXTENSION_INSN_P(insn)		  	      \
+  (REG_ZERO_EXTENSION_INSN_P (insn) || MEM_ZERO_EXTENSION_INSN_P (insn))
+
