+/* Return true if we are able to strip off zero extend of REG.
+   This only handles subregs and nothing else.  
+   FIXME: This should really be done somewhere else and
+   without another pass on the IR, CSE should have detected that
+   (zero_extend:DI (subreg:SI/u (reg:DI N)) is the same as (reg:DI N)
+   but time is running out and this is the quickest way I could modify
+   the code that transmeta added which was not wrong, just not conserative
+   enough.  This additional check is conserative and fixes the regression.  */
+
+static bool
+pd_def_ok (pd_insn_info *pdinsns, rtx reg, bool top_one, struct df *df, unsigned oldregn, int limit)
+{
+  unsigned a;
+  struct df_link *defs_link;
+  limit --;
+  if (limit <= 0)
+    return false;
+
+  /* If aggresive is requested, trust the user.  */
+  if (flag_ptr_extension_reduction_really_agg)
+    return true;
+
+  if (GET_CODE (reg) != REG)
+    return false;
+
+  a = REGNO (reg);
+
+  if (a < FIRST_PSEUDO_REGISTER)
+    return false;
+
+  if (oldregn == a)
+    return true;
+
+  if (df->regs[a].n_defs == 0)
+    return true;
+
+  for (defs_link = df->regs[a].defs; defs_link; defs_link = defs_link->next)
+    {
+      rtx insn = defs_link->ref->insn;
+      rtx r;
+      r = single_set (insn);
+      if (!r)
+	return false;
+      r = SET_SRC (r);
+
+      if (r == reg)
+	continue;
+
+      /* For REGs, just look at its def only if we are the top level check,
+         to make sure we don't go into an infinite loop. */
+      if (top_one
+	  && GET_CODE (r) == REG
+	  && pd_def_ok (pdinsns, r, false, df, a, limit))
+	continue;
+
+      /* For Subregs, check if they are promoted unsigned.  */
+      if (GET_CODE (r) == SUBREG
+	  && SUBREG_PROMOTED_VAR_P (r)
+	  && SUBREG_PROMOTED_UNSIGNED_P (r))
+        continue;
+
+      /* For mem loads, we just have to check if the load is zero
+	 extended. */
+      if (GET_CODE (r) == MEM)
+ 	{
+	  if (LOAD_EXTEND_OP (GET_MODE (r)) == ZERO_EXTEND)
+	    continue;
+	}
+
+     /* Assume that if we have a PLUS with a constant
+ 	operand, that we can do this optimization if the
+	other operand is ok. */
+     if (GET_CODE (r) == PLUS)
+	{
+	  if (GET_CODE (XEXP (r, 1)) == CONST_INT
+	      && GET_CODE (XEXP (r, 0)) == REG
+	      && ((HOST_WIDE_INT)INTVAL (XEXP (r, 1))) > 0)
+	    {
+	      rtx reg1 = XEXP (r, 0);
+	      if (reg1 == reg)
+		continue;
+	      if (REGNO (reg1) == oldregn)
+		continue;
+	      if (pd_def_ok (pdinsns, reg1, true, df, a, limit))
+		continue;
+	    }
+	}
+
+#if 0
+      /* For PLUS/MINUS, we would like to handle signed_ext+signed_ext but this needs some more thought, it
+         could be another function is needed. */
+      if (GET_CODE (r) == PLUS || GET_CODE (r) == MINUS)
+	{
+	  /* PLUS and MINUS are a bit different and hard to handle currently except when one is a constant.  */
+	  /*if (!pd_def_ok (XEXP (r, 0), false, df))
+	    return false;
+	  if (!pd_def_ok (XEXP (r, 1), false, df))*/
+	  if (GET_CODE (XEXP (r, 1)) != CONST_INT)
+	    return false;
+	  if (!pd_def_ok (XEXP (r, 0), true, df))
+	    return false;
+	}
+#endif
+      /* Don't handle anything else for now. */
+      return false;
+    }
+  return true;
+}
