+/* insert machine specific nops, check block alignment, nonpipeline insn at pipe1 */
+/* check veccmp-br sequence, check mfcrt-br sequence */
+void 
+rs6000_sched_fixup_cell (FILE *sched_dump, int sched_verbose)
+{
+  rtx  next_tail;
+  int cycle_laps, num_insns;
+  rtx insn, link, depinsn;
+ 
+  /* this fixup should be for single threads as well, currently we borrow this flag */ 
+  if (!rs6000_gen_multithread_sched) 
+    return;
+
+  if (!reload_completed) 
+    return;
+ 
+  next_tail = NEXT_INSN (current_sched_info->tail);
+  for ( insn = current_sched_info->head; insn != next_tail; insn = NEXT_INSN(insn))
+  {
+    if (!insn || !INSN_P (insn)
+	|| GET_CODE (PATTERN (insn)) == USE
+	|| GET_CODE (PATTERN (insn)) == CLOBBER)
+      continue;	 
+
+    /* fix up veccmp-branch, fpcompare-branch */  
+    if (get_attr_type(insn) == TYPE_VECCMP || get_attr_type(insn) == TYPE_FPCOMPARE)    
+    {
+      for (link = INSN_DEPEND (insn); link; link = XEXP (link, 1))
+        {
+	  depinsn = XEXP(link, 0);
+          if (!INSN_P(depinsn))
+            continue;
+
+          if (GET_CODE (PATTERN (depinsn)) == USE
+	      || GET_CODE (PATTERN (depinsn)) == CLOBBER)
+	      continue;
+
+	  if (get_attr_type(depinsn) == TYPE_BRANCH 
+	    || (get_attr_type(depinsn) == TYPE_CR_LOGICAL) 
+            || (get_attr_type(depinsn) == TYPE_DELAYED_CR))
+	  {
+	    /* find it, if the distance is less than 10, insert a nop8 */
+	    cycle_laps = INSN_BLOCK_CYCLE (depinsn) - INSN_BLOCK_CYCLE (insn);
+	    if (cycle_laps < 0)
+	      continue; /* something wrong */
+	    
+	    if (cycle_laps < 12)
+	    {
+	      if (cycle_laps <= 4)
+	      {
+                INSN_NEEDNOP10(insn) = 1;
+	        if (sched_verbose > 2)
+	           fprintf (sched_dump,"Inserting nop10 for veccmp-branch");
+              }
+	      else
+              {
+                INSN_NEEDNOP8(insn) = 1;
+                if (sched_verbose > 2)
+                   fprintf (sched_dump,"Inserting nop8 for veccmp-branch");
+              }
+	    }
+	  } 
+	}	
+    }
+
+    /* fixup mtctr-branch to ctr */
+    if (get_attr_type(insn) == TYPE_MTJMPR)
+    {
+      if (GET_CODE (XEXP(PATTERN(insn), 0)) == REG
+          && REGNO (XEXP (PATTERN(insn), 0)) == CTR_REGNO)
+      {
+        for (link = INSN_DEPEND (insn); link; link = XEXP (link, 1))
+        {
+	  depinsn = XEXP(link, 0); 
+          if (!INSN_P(depinsn))
+	    continue;
+	   
+	  if ( GET_CODE (PATTERN (depinsn)) == USE
+            || GET_CODE (PATTERN (depinsn)) == CLOBBER)
+              continue;
+
+	  /* indirect_jumpdi, return_internal_di, call_indirect_nonlocal_aix64 call_value_indirect_nonlocal_aix64 */
+          if ( get_attr_type(depinsn) == TYPE_JMPREG)
+	  {
+	    num_insns = 0;
+            cycle_laps = INSN_BLOCK_CYCLE (depinsn) - INSN_BLOCK_CYCLE (insn);
+            if (cycle_laps < 0 || cycle_laps > 12)
+              continue;
+	      
+            /* need to insert more nops 
+            for (tmp = insn; tmp != depinsn; tmp = NEXT_INSN(tmp))
+            {
+              num_insns++;
+              if(tmp == next_tail)
+	        abort();
+            }
+
+            if (num_insns < 3)
+	       continue; 
+	    */
+              
+            if (cycle_laps < 10) 
+            {
+              INSN_NEEDNOP8(insn) = 1;
+              if (sched_verbose > 2)
+                 fprintf (sched_dump,"Inserting nop8 for mtctr-bcctr/bcctrl\n");
+            }
+          }
+/* branch and decrement count - do nothing */
+        }
+      }
+    }
+  }
+  rs6000_sched_finish_cell(sched_dump, sched_verbose);  
+}
