+/* Mark destination operands in INSN as partial dirty in bitmap WSET if 
+   IS_DIRTY is true
+ */
+
+static void
+pd_mark_dest_dirty (rtx insn, bitmap wset, bool is_dirty, struct df *df)
+{
+  unsigned int uid = INSN_UID (insn);
+  struct df_link *link;
+ 
+  for (link = df->insns[uid].defs; link; link = link->next)
+    {
+      int regno;
+
+      if (DF_REF_REG_DEF_P (link->ref))
+        {
+	  /* Conservative, may only need to check SI or subreg mode */ 
+	  regno = REGNO (DF_REF_REAL_REG (link->ref));
+	  is_dirty ? bitmap_set_bit (wset, regno) : 
+	             bitmap_clear_bit (wset, regno);
+	}
+    }
+}
+
+/* Return true if any source operand is a constant and is greater than the 
+   largest pointer value.  
+ */
+
+static bool
+pd_is_any_opnd_wider_const (rtx *exp)
+{
+  RTX_CODE code;
+  rtx x = *exp;
+
+  if (!x)
+    return false;
+
+  code = GET_CODE (x);
+  if (code == CONST_INT &&
+      ((unsigned HOST_WIDE_INT) (INTVAL (x)) >= 
+       (unsigned HOST_WIDE_INT) (1 << POINTER_SIZE)))
+    return true;
+ 
+  /* Recursively scan the operands of this expression.  */
+  {
+    const char *fmt = GET_RTX_FORMAT (code);
+    int i;
+
+    for (i = GET_RTX_LENGTH (code) - 1; i >= 0; i--)
+      {
+        if (fmt[i] == 'e')
+          {
+	    if (pd_is_any_opnd_wider_const (&XEXP (x, i)))
+	      return true;
+          }
+        else if (fmt[i] == 'E')
+          {
+            int j;
+            for (j = 0; j < XVECLEN (x, i); j++)
+	      if (pd_is_any_opnd_wider_const (&XVECEXP (x, i, j)))
+		return true;
+          }
+      }
+  }
+  
+  return false;
+}
+
+/* Return true if any source operand in INSN is marked partial dirty in 
+   bitmap WSET 
+ */
+
+static bool
+pd_is_any_src_dirty (rtx insn, bitmap wset, struct df *df)
+{
+  unsigned int uid = INSN_UID (insn);
+  struct df_link *link;
+ 
+  for (link = df->insns[uid].uses; link; link = link->next)
+    {
+      int regno;
+	
+      if (DF_REF_REG_MEM_P (link->ref))
+	return true;
+
+      gcc_assert (DF_REF_REG_USE_P (link->ref));
+
+      regno = REGNO (DF_REF_REAL_REG (link->ref));
+      if (bitmap_bit_p (wset, regno))
+	return true;
+    }
+
+  /* Conservatively assume if any operand is constant and is greater than the 
+     largest  pointer value, the source is partially dirty */
+  if (NONJUMP_INSN_P (insn) && pd_is_any_opnd_wider_const (&PATTERN (insn)))
+    return true;
+  
+  return false;
+}
+
+/*
+  Propagate partial dirty register information in basic-block BB
+  and record the information at each instruction in PDINSNS 
+*/
+
+static void
+pd_bb_propagate (basic_block bb, pd_insn_info *pdinsns, struct df *df)
+{
+  rtx insn, bound;
+  bool dst_dirty;
+  bitmap wset = BITMAP_ALLOC (NULL);
+
+  if (PD_BB_INFO (bb)->visited)
+    return;
+
+  PD_BB_INFO (bb)->visited = true;
+  bitmap_copy (wset, PD_BB_INFO (bb)->live_pdin);
+
+  bound = NEXT_INSN (BB_END (bb));
+  for (insn = BB_HEAD (bb); insn != bound; insn = NEXT_INSN (insn))
+    if (INSN_P (insn))
+      {
+	bitmap_ior_into (pdinsns[INSN_UID(insn)].live_pd, wset);
+		
+	dst_dirty = true;
+	if (ZERO_EXTENSION_INSN_P (insn))
+	  dst_dirty = false;
+	else 
+	  dst_dirty = pd_is_any_src_dirty (insn, wset, df) ? true : false;
+		
+	/* set each destination register partially dirty */
+	pd_mark_dest_dirty (insn, wset, dst_dirty, df);
+      }
+    
+  bitmap_ior_into (PD_BB_INFO (bb)->live_pdout, wset);
+
+  BITMAP_FREE (wset);
+}
