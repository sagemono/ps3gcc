+void 
+rs6000_inserting_nop8(rtx insn, rtx *depinsn)
+{
+  rtx from, frominsn;
+  int fromcycle = 0;
+  int fromlatency = 0;
+
+  for (from = LOG_LINKS(insn); from; from = XEXP (from, 1))
+    {
+      frominsn =  XEXP (from, 0);
+      if (!frominsn || !INSN_P (frominsn)
+	  || GET_CODE (PATTERN (frominsn)) == USE
+	  || GET_CODE (PATTERN (frominsn)) == CLOBBER)
+	    continue;
+      
+      if (recog_memoized (frominsn) < 0)
+	    continue;
+
+      if  (get_attr_type(frominsn) == TYPE_FP
+	|| get_attr_type(frominsn) == TYPE_VECCOMPLEX
+	|| get_attr_type(frominsn) == TYPE_VECFLOAT)	 
+          {
+	    if  (fromcycle < INSN_BLOCK_CYCLE (frominsn))
+	      {
+		*depinsn = frominsn;
+		fromcycle = INSN_BLOCK_CYCLE (frominsn);
+		fromlatency = INSN_COST(frominsn);
+	      }
+	  }
+    }
+    /* 
+     * if (fromcycle && sched_verbose)
+     *   fprintf (dump, "insertiong nop after insn %s\n", (*current_sched_info->print_insn)(depinsn, 0));  
+     */
+    if (fromcycle && *depinsn && recog_memoized (insn) >= 0)
+      {
+	INSN_NEEDNOP8(*depinsn) = 1;
+      }
