+  int fallthru_cost = 0, taken_cost = 0;
+  rtx *reg_map_fallthru = 0, *reg_map_taken = 0, *reg_map_orig = 0, seq;
+  regset exposed_set;
+  int i, nregs, status, n_insns = 0, n_cmovs = 0;
+
+  info.jump = BB_END (hdr);
+
+  /* Ensure the condition in the branch at the end of the header block 
+     is conformable to transformation. */
+
+  if (!onlyjump_p (info.jump))
+    return FALSE;
+
+  info.cond = noce_get_condition (info.jump, &info.cond_earliest);
+
+  if (!info.cond || (GET_MODE (XEXP (info.cond, 0)) == BLKmode))
+    return FALSE;
+
+  fallthru_cost = fallthru ? count_bb_insns (fallthru) : 0;
+  taken_cost = taken ? count_bb_insns (taken) : 0;
+
+  /* Determine if it is cost effective to proceed. */
+
+  if (!cost_effective_p (fallthru_cost, taken_cost, info.jump))
+    return FALSE;
+
+  /* Determine which register we need to replace with pseudos. */
+  exposed_set = ALLOC_REG_SET (&reg_obstack);
+  /* CELL FIXME: check to see if il_rtl is initialized properly. */
+  COPY_REG_SET (exposed_set, ce_info->test_bb->il.rtl->global_live_at_end);
+  mark_regs_in_rtx (info.cond, exposed_set);
+  if (fallthru)
+    IOR_REG_SET (exposed_set, fallthru->il.rtl->global_live_at_end);
+  if (taken)
+    IOR_REG_SET (exposed_set, taken->il.rtl->global_live_at_end);
+
+  nregs = max_regno;
+
+  /* Change all register references so that there will be no conflicts 
+     when moving the fallthru and taken blocks to the test block. */
+  status = 0;
+  reg_map_orig = xcalloc (nregs, sizeof (rtx));
+  if (fallthru)
+    {
+      reg_map_fallthru = xcalloc (nregs, sizeof (rtx));
+      status = remap_instructions (fallthru, reg_map_fallthru, reg_map_orig, nregs, exposed_set);
+    }
+  if (status >= 0 && taken)
+    {
+      reg_map_taken = xcalloc (nregs, sizeof (rtx));
+      status = remap_instructions (taken, reg_map_taken, reg_map_orig, nregs, exposed_set);
+    }
