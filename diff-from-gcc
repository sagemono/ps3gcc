+/* The function allocates the info structures of each instruction. */
+
+static pd_insn_info *
+pd_insn_table_realloc (void)
+{
+  int i;
+  int n_insns;
+  pd_insn_info *pdinsns;
+
+  n_insns = get_max_uid () + 1;
+  pdinsns = xmalloc (n_insns * sizeof (pd_insn_info));  
+
+  for (i = 0; i < n_insns; i++) 
+    pdinsns[i].live_pd = BITMAP_ALLOC (NULL);
+
+  return pdinsns;
+}
