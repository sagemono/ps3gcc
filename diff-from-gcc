+static arelent*
+find_a_rel (bfd_vma offset, arelent **relocs, int relcount)
+{
+  arelent *rp;
+
+  if (relocs == NULL)
+    return NULL;
+
+  for ( ; relcount > 0 && *relocs != NULL; ++relocs, --relcount)
+    {
+      rp = *relocs;
+      if ((bfd_vma)rp->address == offset)
+	return rp;
+    }
+  return NULL;
+}
+
+/* begin sce local */
+/* Display OPD section */
+static void
+dump_a_opd_entry_with_sym  (asection *sec, bfd_byte *data,
+			    bfd_vma offset,
+			    struct disassemble_info *info,
+			    size_t addrsize)
+{
+  asymbol *sym;
+  long place = 0;
+  bfd_vma addr;
+  const char * sym_name, *sec_name, *r_type_name;
+  arelent *rp;
+
+  struct objdump_disasm_info * paux =
+    (struct objdump_disasm_info *)info->application_data;
+
+
+  /* print the address of 1st entry */
+  if (addrsize == 4)
+    {
+      addr = bfd_get_32 (sec->owner, &data[offset]);
+      printf ("\t%08x\t", (unsigned int)addr);
+    }
+  else
+    {
+      addr = bfd_get_64 (sec->owner, &data[offset]);
+      printf ("\t%016llx\t", (unsigned long long)addr);
+    }
+
+  /* Find the relocation for the 1st entry */
+  rp = find_a_rel (offset, paux->dynrelbuf, paux->dynrelcount);
+  if (rp != NULL)
+    {
+      if (rp->sym_ptr_ptr != NULL
+	  && *(rp->sym_ptr_ptr) != NULL)
+	{
+	  sym_name = (*(rp->sym_ptr_ptr))->name;
+	  sec_name = (*(rp->sym_ptr_ptr))->section->name;
+	  r_type_name = rp->howto->name;
+	}
+      else
+	{
+	  sym_name = "<unknown symbol>";
+	  sec_name = "<unknown section>";
+	  r_type_name = "UNKNWON_RELOC_TYPE";
+	}
+      printf ("%s %s %s", r_type_name, sym_name, sec_name);
+    }
+  else 
+    {
+      sym = find_symbol_for_address (addr, info, &place);
+      if (sym != NULL)
+	bfd_print_symbol (sec->owner, stdout, sym, bfd_print_symbol_name);
+      else
+	printf ("<unknown>");
+    }
+}
+
+static void
+dump_function_descriptors (bfd *abfd, asection *section, void *info)
+{
+  struct disassemble_info *    disasm = (struct disassemble_info *) info;
+  struct objdump_disasm_info * paux = 
+    (struct objdump_disasm_info *) disasm->application_data;
+  bfd_byte *                   data = NULL;
+  bfd_size_type                datasize = 0;
+  bfd_vma offset;
+  int addrsize;
+
+
+  /* Sections that do not contain machine
+     code are not normally disassembled.  */
+  if (! process_section_p (section))
+    return;
+
+  datasize = bfd_get_section_size (section);
+  if (datasize == 0)
+    return;
+
+  /* if the target does not have function desc, skip this section */
+  if (! (bfd_get_arch (abfd) == bfd_arch_powerpc
+	 && strcmp (section->name, ".opd") == 0))
+    return;
+
+  if (elf_elfheader(abfd)->e_ident[EI_OSABI] == ELFOSABI_CELLOSLV2)
+    addrsize = 4;
+  else
+    addrsize = 8;
+
+  printf ("Function Descriptor Section Dump: .opd\n");
+
+  paux->sec = section;
+  /* slurp relocation info */
+  if ((section->flags & SEC_RELOC) != 0)
+    {
+      arelent **relpp;
+      long relsize;
+      long relcnt;
+
+      relsize = bfd_get_reloc_upper_bound (abfd, section);
+      relpp = xmalloc (relsize);
+      relcnt = bfd_canonicalize_reloc (abfd, section, relpp, syms);
+
+      if (relcnt < 0)
+	bfd_fatal (bfd_get_filename (abfd));
+
+      paux->dynrelbuf = relpp;
+      paux->dynrelcount = relcnt;
+    }
+
+  /* load section contents */
+  data = xmalloc (datasize);
+  bfd_get_section_contents (abfd, section, data, 0, datasize);
+
+  for (offset = 0; offset < datasize; offset += addrsize)
+    {
+
+      bfd_vma fd_addr = section->vma + offset;
+      asymbol * sym;
+      long place = 0;
+  
+      printf ("%08x: <", (unsigned int)fd_addr);
+      sym = find_symbol_for_address (fd_addr, info, &place);
+      if (sym != 0)
+	bfd_print_symbol (section->owner, stdout, sym, bfd_print_symbol_name);
+      else
+	printf ("unknown");      
+      printf (">\n");
+
+      /* Dump 1st entry */
+      dump_a_opd_entry_with_sym (section, data, offset, info, addrsize);
+      printf ("\n");
+      
+      /* Dump 2nd entry */
+      offset += addrsize;
+      dump_a_opd_entry_with_sym (section, data, offset, info, addrsize);
+      printf ("\n");
+
+      /* In case of PowerPC64 Linux ABI, there may be 3rd entry */
+      if (addrsize == 8)
+	{
+	  offset += addrsize;
+	  /* FIXME
+	     for this entry, we dont show any symbol information.  */
+	  printf ("\t%016llx\n", (unsigned long long) (section->vma + offset));
+	}
+    }
+
+  free (data);
+}
