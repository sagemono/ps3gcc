+	case 'w': flag = SECTION_WRITE; break;
+	case 'x': flag = SECTION_CODE; break;
+	case 's': flag = SECTION_SMALL; break;
+	case 'M': flag = SECTION_MERGE; break;
+	case 'S': flag = SECTION_STRINGS; break;
+	case 'T': flag = SECTION_TLS; break;
+	case 'G': flag = SECTION_LINKONCE; break;
+
+	case 'b':
