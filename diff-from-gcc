+      bsi_remove (&next_si);
+      next_stmt_info = vinfo_for_stmt (next);
+      ann = stmt_ann (next);
+      tmp = DR_GROUP_NEXT_DR (next_stmt_info);
+      free (next_stmt_info);
+      set_stmt_info ((tree_ann_t)ann, NULL);
+      next = tmp;
+    }
