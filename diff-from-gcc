+          move_bytes = 2;
+          mode = HImode;
+          gen_func.mov = gen_movhi;
+        }
+      else /* move 1 byte at a time */
+        {
+          move_bytes = 1;
+          mode = QImode;
+          gen_func.mov = gen_movqi;
+        }
