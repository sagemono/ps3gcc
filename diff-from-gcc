+/* Resort the array A in which only element at index N may be out of order.  */
+
+static inline  void
+swap (rtx *a, int n)
+{
+  rtx insn = a[n - 1];
+  int i = n - 2;
+
+  while (i >= 0 )
+    {
+      a[i + 1] = a[i];
+      i -= 1;
+     }
+   a[i + 1] = insn;
+}
