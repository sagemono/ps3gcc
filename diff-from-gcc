+            || GET_CODE (PATTERN (depinsn)) == CLOBBER)
+              continue;
+
+	  /* indirect_jumpdi, return_internal_di, call_indirect_nonlocal_aix64 call_value_indirect_nonlocal_aix64 */
+          if ( get_attr_type(depinsn) == TYPE_JMPREG)
+	  {
+	    num_insns = 0;
+            cycle_laps = INSN_BLOCK_CYCLE (depinsn) - INSN_BLOCK_CYCLE (insn);
+            if (cycle_laps < 0 || cycle_laps > 12)
+              continue;
+	      
+            /* need to insert more nops 
+            for (tmp = insn; tmp != depinsn; tmp = NEXT_INSN(tmp))
+            {
+              num_insns++;
+              if(tmp == next_tail)
+	        abort();
+            }
+
+            if (num_insns < 3)
+	       continue; 
