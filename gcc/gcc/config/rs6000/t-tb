#rs6000/t-lv2

NATIVE_SYSTEM_HEADER_DIR = /include

# Need to remove header files in the gcc/include directory so that dejagnu 
# tests are seeing the dinkumware version.
int-hdr-cleanup:
	hdrs="float.h math.h stdbool.h stdlib.h varargs.h iso646.h stddef.h syslimits.h limits.h stdarg.h stdio.h" ; \
	for f in $$hdrs ; do \
	  rm -f include/$$f ; \
	done

LIB2FUNCS_EXTRA = tramp.S $(srcdir)/config/rs6000/ppc64-fp.c xp-bit.c

TARGET_LIBGCC2_CFLAGS = -mno-minimal-toc -fPIC -mno-altivec

MULTILIB_OPTIONS        = fno-exceptions
MULTILIB_DIRNAMES       = noeh
LIBGCC = stmp-multilib
INSTALL_LIBGCC    = install-multilib

# We want fine grained libraries, so use the new code to build the
# floating point emulation libraries.
# fp-bit is only to be used by 32-bit multilibs
FPBIT = fp-bit32.c
DPBIT = dp-bit32.c

dp-bit32.c: $(srcdir)/config/fp-bit.c
	( echo '#if !defined(__powerpc64__) || (defined __powerpc64__ &&  defined _SOFT_FLOAT)'; \
	  cat $(srcdir)/config/fp-bit.c; \
	  echo '#endif' ) > dp-bit32.c

fp-bit32.c: $(srcdir)/config/fp-bit.c
	( echo '#if !defined(__powerpc64__) || (defined __powerpc64__ &&  defined _SOFT_FLOAT)'; \
	  echo '#define FLOAT'; \
	  cat $(srcdir)/config/fp-bit.c; \
	  echo '#endif' ) > fp-bit32.c

xp-bit.c: $(srcdir)/config/fp-bit.c
	echo '#define EXTENDED_FLOAT_STUBS' > xp-bit.c
	cat $(srcdir)/config/fp-bit.c >> xp-bit.c
