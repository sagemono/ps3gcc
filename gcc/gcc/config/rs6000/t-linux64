
#rs6000/t-linux64

LIB2FUNCS_EXTRA = tramp.S $(srcdir)/config/rs6000/ppc64-fp.c \
	$(srcdir)/config/rs6000/darwin-ldouble.c xp-bit.c

TARGET_LIBGCC2_CFLAGS += -mno-minimal-toc

MULTILIB_OPTIONS        = m64/m32
MULTILIB_DIRNAMES       = 64 32
MULTILIB_EXTRA_OPTS     = fPIC mstrict-align
MULTILIB_EXCEPTIONS     =
MULTILIB_EXCLUSIONS     =
MULTILIB_OSDIRNAMES	= ../lib64 ../lib
MULTILIB_MATCHES        =

# We want fine grained libraries, so use the new code to build the
# floating point emulation libraries.
# fp-bit is only to be used by 32-bit multilibs
FPBIT = fp-bit32.c
DPBIT = dp-bit32.c

dp-bit32.c: $(srcdir)/config/fp-bit.c
	( echo '#if !defined(__powerpc64__) || (defined __powerpc64__ &&  defined _SOFT_FLOAT)'; \
	  cat $(srcdir)/config/fp-bit.c; \
	  echo '#endif' ) > dp-bit32.c

fp-bit32.c: $(srcdir)/config/fp-bit.c
	( echo '#if !defined(__powerpc64__) || (defined __powerpc64__ &&  defined _SOFT_FLOAT)'; \
	  echo '#define FLOAT'; \
	  cat $(srcdir)/config/fp-bit.c; \
	  echo '#endif' ) > fp-bit32.c

xp-bit.c: $(srcdir)/config/fp-bit.c
	echo '#define EXTENDED_FLOAT_STUBS' > xp-bit.c
	cat $(srcdir)/config/fp-bit.c >> xp-bit.c
