   02111-1307, USA.  */



// Syntax: PGO_MODE (SYMBOL, "NAME", KIND, bitsize)
// Symbol concatenation is avoided to keep searching simple.

#ifndef PGO_MODE
#error "PGO_MODE not defined"
#endif

PGO_MODE (PGO_MODE_VOID, "VOID", PGO_MKIND_OTHER, 0)

PGO_MODE (PGO_MODE_QI, "QI", PGO_MKIND_INT, 8)
PGO_MODE (PGO_MODE_HI, "HI", PGO_MKIND_INT, 16)
PGO_MODE (PGO_MODE_SI, "SI", PGO_MKIND_INT, 32)
PGO_MODE (PGO_MODE_DI, "DI", PGO_MKIND_INT, 64)
PGO_MODE (PGO_MODE_TI, "TI", PGO_MKIND_INT, 128)

// That's it for now.

#undef PGO_MODE
